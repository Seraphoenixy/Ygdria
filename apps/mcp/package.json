{
  "name": "@ygdria/mcp",
  "version": "0.1.0",
  "description": "MCP server for Ygdria ETAPI",
  "type": "module",
  "bin": {
    "ygdria-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ygdria-mcp.example.ini"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.bundle.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.bundle.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsc -p tsconfig.json && node --test dist/client/etapi-client.test.js dist/config.test.js dist/server.test.js dist/tools/get-tree.test.js dist/tools/shared.test.js dist/tools/convenience.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "license": "Apache-2.0"
}
