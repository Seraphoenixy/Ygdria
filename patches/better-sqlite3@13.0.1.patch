diff --git a/lib/install.js b/lib/install.js
new file mode 100644
index 0000000..b99f8cc
--- /dev/null
+++ b/lib/install.js
@@ -0,0 +1,26 @@
+'use strict';
+
+const childProcess = require('child_process');
+const fs = require('fs');
+const path = require('path');
+
+const platform = process.platform === 'linux' && !process.report.getReport().header.glibcVersionRuntime
+  ? 'linuxmusl'
+  : process.platform;
+const prebuild = path.join(__dirname, '..', 'prebuilds', `${platform}-${process.arch}.node`);
+
+// An explicit install script prevents npm from implicitly running `node-gyp
+// rebuild` merely because binding.gyp is present.  Native compilation is only
+// needed for platforms or architectures without an included Node-API binary.
+if (fs.existsSync(prebuild)) {
+  process.exit(0);
+}
+
+const command = process.platform === 'win32' ? 'node-gyp.cmd' : 'node-gyp';
+const result = childProcess.spawnSync(command, ['rebuild'], {
+  cwd: path.join(__dirname, '..'),
+  stdio: 'inherit',
+});
+
+if (result.error) throw result.error;
+process.exit(result.status === null ? 1 : result.status);
